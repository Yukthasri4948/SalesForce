
PlacementHome.Html
<template>

    <div class="container">

        <!-- Header -->
        <div class="header">

            <h1>🎓 Placement Portal</h1>

            <p>
                Today's Date : {todayDate}
            </p>

        </div>


        <!-- Welcome Section -->
        <div class="welcome-section">

            <h2>
                Welcome {studentName} 👋
            </h2>

        </div>


        <!-- Student Information -->
        <div class="student-section">

            <h2>Student Information</h2>

            <p>
                <b>Student Name:</b> {studentName}
            </p>

            <p>
                <b>Roll Number:</b> {rollNumber}
            </p>

            <p>
                <b>Department:</b> {department}
            </p>

        </div>


        <!-- Placement Statistics -->
        <div class="statistics-section">

            <h2>Placement Statistics</h2>

            <div class="cards">

                <!-- Companies Card -->
                <div class="card">

                    <h3>Companies</h3>

                    <p class="number">
                        {companyCount}
                    </p>

                </div>


                <!-- Jobs Card -->
                <div class="card">

                    <h3>Jobs</h3>

                    <p class="number">
                        {jobCount}
                    </p>

                </div>


                <!-- Applications Card -->
                <div class="card">

                    <h3>Applications</h3>

                    <p class="number">
                        {applicationCount}
                    </p>

                </div>

            </div>

        </div>


        <!-- Welcome Button -->
        <div class="button-section">

            <lightning-button
                label="Show Welcome Message"
                variant="brand"
                onclick={handleWelcome}>
            </lightning-button>

            <p class="message">
                {welcomeMessage}
            </p>

        </div>


        <!-- Application Section -->
        <div class="application-section">

            <h2>Job Application</h2>

            <p class="status">
                Status : {applicationStatus}
            </p>

            <lightning-button
                label="Apply Now"
                variant="success"
                onclick={handleApply}>
            </lightning-button>

        </div>

    </div>

</template>

PlacementHome.css
.container {
    padding: 25px;
}


/* Header */

.header {
    text-align: center;
    padding: 20px;
    margin-bottom: 20px;
}

.header h1 {
    font-size: 30px;
    font-weight: bold;
}

.header p {
    font-size: 16px;
}


/* Welcome */

.welcome-section {
    margin-bottom: 25px;
}

.welcome-section h2 {
    font-size: 22px;
}


/* Student Information */

.student-section {
    padding: 15px;
    margin-bottom: 25px;
}

.student-section h2 {
    font-size: 20px;
}


/* Statistics */

.statistics-section {
    margin-bottom: 25px;
}

.cards {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 20px;

    margin-top: 15px;
}


/* Individual Card */

.card {
    padding: 20px;

    text-align: center;

    border-radius: 10px;

    box-shadow:
        0 2px 8px
        rgba(0, 0, 0, 0.15);
}

.card h3 {
    font-size: 18px;
}

.number {
    font-size: 30px;

    font-weight: bold;
}


/* Buttons */

.button-section {
    margin-top: 25px;

    margin-bottom: 25px;
}

.message {
    margin-top: 15px;

    font-size: 18px;

    font-weight: bold;
}


/* Application */

.application-section {
    margin-top: 25px;

    padding: 20px;
}

.application-section h2 {
    font-size: 20px;
}

.status {
    font-size: 18px;

    font-weight: bold;

    margin-bottom: 15px;
}


PlacementHome.js
import { LightningElement } from 'lwc';

export default class PlacementHome extends LightningElement {

    // Student Information
    studentName = 'Yukthasri';

    rollNumber = '22B81A0501';

    department = 'CSE';


    // Today's Date
    todayDate = '31 July 2026';


    // Placement Statistics
    companyCount = 25;

    jobCount = 63;

    applicationCount = 5;


    // Welcome Message
    welcomeMessage = '';


    // Application Status
    applicationStatus = 'Not Applied';


    // Show Welcome Message Button
    handleWelcome() {

        this.welcomeMessage =
            'Welcome to Salesforce Development';

    }


    // Apply Now Button
    handleApply() {

        this.applicationStatus = 'Applied';

    }

}

